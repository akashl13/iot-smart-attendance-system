# PostgreSQL connection used by Drizzle ORM.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Long random string. Never expose this to the browser.
JWT_SECRET=replace-with-a-long-random-string

# Next.js listens on PORT. The platform sets this automatically.
PORT=3000

# Browser origin allowed to call the API from another host.
CLIENT_URL=http://localhost:3000

# Optional shared secret for NodeMCU. Leave empty during local demos.
# When set, /api/rfid/scan and /api/devices/heartbeat require header x-device-key.
DEVICE_API_KEY=

# Show the demo login panel. Set to false before a public deployment.
SHOW_DEMO_CREDENTIALS=true

# The project brief named MongoDB. This running application uses PostgreSQL.
# MONGODB_URI is unused and kept only so the expected variable name is documented.
MONGODB_URI=
